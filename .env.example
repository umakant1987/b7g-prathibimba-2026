# Set to "false" to use live API/Supabase data instead of bundled mock data
VITE_USE_MOCK_DATA=true

# REST API that fronts Supabase (programs, impact-stats, sponsors, gallery)
VITE_API_URL=

# Supabase project — shared reaction counters (run supabase/reactions.sql first).
# Use the Project URL and the publishable/anon key, never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI assistant (see docs/RAG.md). Browser: the backend RAG endpoint.
# Leave empty to run the chat fully offline.
VITE_RAG_API_URL=

# Detailed programme (website + AI). false = programme posters only, until it is released.
VITE_SHOW_PROGRAMME_DETAILS=false

# Contribute section (QR codes, phone) on the website and in the AI. false = hidden until released.
VITE_SHOW_CONTRIBUTE=false

# --- Backend only (never prefix these with VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RAG_LLM_MODEL=claude-opus-5-5
RAG_DEBUG=false
